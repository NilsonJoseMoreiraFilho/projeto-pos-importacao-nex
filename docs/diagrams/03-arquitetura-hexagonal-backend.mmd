    class importPort,reviewPort,approvePort,exportPort,documentReader,repository,catalog,exporter portStyle;
    class importUseCase,reviewUseCase,approveUseCase,exportUseCase,mapper,importValidator appStyle;
    class entities,rules,approvalPolicy domainStyle;
    class manualJson,persistence,csv drivenStyle;
